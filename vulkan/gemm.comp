#version 450
// Vulkan compute shader: batched GEMM C = A × B^T
// A: [M, K], B: [N, K] → C: [M, N]
// Each workgroup computes a tile of output

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint M;        // output rows
    uint N;        // output cols
    uint K;        // inner dimension
    uint batch;    // batch offset multiplier
    float alpha;   // optional scaling
} pc;

// Input/output: float16 stored as uint32 (lower 16 bits)
layout(set=0, binding=0) readonly buffer A { uint a_data[]; };  // [batch, M, K]
layout(set=0, binding=1) readonly buffer B { uint b_data[]; };  // [batch, N, K] (transposed)
layout(set=0, binding=2) writeonly buffer C { uint c_data[]; };  // [batch, M, N]

// FP16 conversion helpers
float unpack_f16(uint packed) {
    uint sign = (packed >> 15) & 1u;
    uint exp  = (packed >> 10) & 0x1Fu;
    uint mant = packed & 0x3FFu;
    if (exp == 0u) return float(sign != 0u ? -1.0 : 1.0) * float(mant) / 1024.0 * exp2(-14.0);
    if (exp == 0x1Fu) return float(mant == 0u ? (sign != 0u ? -1.0 : 1.0) * 1.0/0.0 : 0.0/0.0);
    float value = 1.0 + float(mant) / 1024.0;
    return float(sign != 0u ? -1.0 : 1.0) * value * exp2(float(exp) - 15.0);
}

uint pack_f16(float value) {
    if (isnan(value)) return 0x7E00u;
    uint sign = (value < 0.0) ? 0x8000u : 0u;
    value = abs(value);
    if (value == 0.0) return sign;
    if (isinf(value)) return sign | 0x7C00u;
    float scaled = value;
    int exp_val = 0;
    while (scaled >= 2.0) { scaled *= 0.5; exp_val++; }
    while (scaled < 1.0 && exp_val > -14) { scaled *= 2.0; exp_val--; }
    if (exp_val > 15) return sign | 0x7C00u;
    if (exp_val < -14) return sign;
    uint mant = uint((scaled - 1.0) * 1024.0) & 0x3FFu;
    uint exp_bits = uint(exp_val + 15) & 0x1Fu;
    return sign | (exp_bits << 10) | mant;
}

// Shared memory for A and B tiles
shared float a_tile[16][16];
shared float b_tile[16][16];

void main() {
    uint batch_idx = gl_GlobalInvocationID.z;
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row >= pc.M || col >= pc.N) return;

    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    float sum = 0.0;
    uint tiles = (pc.K + 15u) / 16u;

    for (uint t = 0u; t < tiles; t++) {
        // Cooperative load of A tile
        uint a_k = t * 16u + local_col;
        if (row < pc.M && a_k < pc.K) {
            uint a_idx = batch_idx * (pc.M * pc.K) + row * pc.K + a_k;
            a_tile[local_row][local_col] = unpack_f16(a_data[a_idx]);
        } else {
            a_tile[local_row][local_col] = 0.0;
        }

        // Cooperative load of B tile (B is stored as [N, K])
        uint b_k = t * 16u + local_row;
        if (col < pc.N && b_k < pc.K) {
            uint b_idx = batch_idx * (pc.N * pc.K) + col * pc.K + b_k;
            b_tile[local_row][local_col] = unpack_f16(b_data[b_idx]);
        } else {
            b_tile[local_row][local_col] = 0.0;
        }

        barrier();

        // Compute partial dot product
        for (uint k = 0u; k < 16u; k++) {
            sum += a_tile[local_row][k] * b_tile[k][local_col];
        }

        barrier();
    }

    sum *= pc.alpha;
    uint c_idx = batch_idx * (pc.M * pc.N) + row * pc.N + col;
    c_data[c_idx] = pack_f16(sum);
}
