#version 450
// Native fp16 GEMM: f16vec4 + dot() — no shared memory (Adreno barriers too expensive)
// Based on ncnn innerproduct pack4 approach, simplified for pure GEMM.
#extension GL_EXT_shader_16bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) readonly  buffer A_buf { f16vec4 A_pack4[]; };
layout(binding = 1) readonly  buffer B_buf { f16vec4 B_pack4[]; };
layout(binding = 2) writeonly buffer C_buf { float16_t C[]; };

layout(push_constant) uniform PC {
    uint M; uint N; uint K; uint batch; float alpha;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    if (row >= pc.M || col >= pc.N) return;

    float sum = 0.0;
    uint k4 = pc.K / 4u;

    // Sequential f16vec4 global reads: Adreno L2 cache handles this well
    for (uint k = 0u; k < k4; k++) {
        f16vec4 av = A_pack4[row * k4 + k];
        f16vec4 bv = B_pack4[col * k4 + k];
        sum += float(dot(av, bv));
    }

    // Remainder (K % 4) — all our K values (68, 2048, 8192) are divisible by 4
    uint rem = pc.K - k4 * 4u;
    if (rem > 0u) {
        for (uint r = 0u; r < rem; r++) {
            uint k = k4 * 4u + r;
            sum += float(A_pack4[row * k4 + k / 4u][k % 4u])
                 * float(B_pack4[col * k4 + k / 4u][k % 4u]);
        }
    }

    C[row * pc.N + col] = float16_t(sum * pc.alpha);
}
