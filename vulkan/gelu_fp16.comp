#version 450
// GELU activation (tanh approximation): y = 0.5 * x * (1 + tanh(c * (x + k * x^3)))
// where c = sqrt(2/π) ≈ 0.797885, k = 0.044715
// Element-wise, fp16 I/O, fp32 internal.
#extension GL_EXT_shader_16bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer In  { float16_t in_data[];  };
layout(binding = 1) writeonly buffer Out { float16_t out_data[]; };

layout(push_constant) uniform PC {
    uint n_total;
} pc;

const float C = 0.79788456;  // sqrt(2/π)
const float K = 0.044715;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n_total) return;

    float x = float(in_data[i]);
    float x3 = x * x * x;
    float inner = C * (x + K * x3);
    float tanh_val = tanh(inner);  // GLSL built-in
    float y = 0.5 * x * (1.0 + tanh_val);
    out_data[i] = float16_t(y);
}
