#version 450
// SiLU (Swish) activation: y = x * sigmoid(x) — element-wise, fp16
#extension GL_EXT_shader_16bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer In  { float16_t in_data[];  };
layout(binding = 1) writeonly buffer Out { float16_t out_data[]; };

layout(push_constant) uniform PC {
    uint n_total;  // total elements
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n_total) return;

    float x = float(in_data[i]);
    // silu(x) = x / (1 + exp(-x)) — native fp16 exp, accumulate in fp32 for safety
    float y = x / (1.0 + exp(-x));
    out_data[i] = float16_t(y);
}
