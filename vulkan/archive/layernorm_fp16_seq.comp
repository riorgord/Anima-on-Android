#version 450
// LayerNorm fp16: float sequential reduction (matches PyTorch fp32 accumulation)
// One workgroup per row, thread 0 does sequential sum for reduction
// Other threads do element-wise normalize (reuse parallel threads)
#extension GL_EXT_shader_16bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer In  { float16_t in_data[];  };
layout(binding = 1) writeonly buffer Out { float16_t out_data[]; };

layout(push_constant) uniform PC {
    uint n_rows;
    uint n_elems;
    float eps;
} pc;

shared float shm_sum;
shared float shm_sq;

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.n_rows) return;

    uint tid = gl_LocalInvocationID.x;
    uint off = row * pc.n_elems;

    // Pass 1: each thread does sequential sum of its portion
    float my_sum = 0.0;
    for (uint i = tid; i < pc.n_elems; i += 256u) {
        my_sum += float(in_data[off + i]);
    }
    // Use thread 0 to sequentially sum all partial sums
    if (tid == 0u) {
        float total = my_sum;
        barrier();
        for (uint t = 1u; t < 256u; t++) {
            // Other threads write to shm via atomic... simpler: use shm array
        }
    }

    // Actually, just use the original tree — sequential vs tree doesn't matter in fp32
    // The REAL fix is: match PyTorch's EXACT formula
    float mean = my_sum / float(pc.n_elems);
    // ... this approach is getting too complex. Let me try a different strategy.
    //
    // The actual issue might not be in LN at all. Let me check RMSNorm more carefully.
    // PyTorch rms_norm: x * weight * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + eps)
    // Our shader: x * inversesqrt(mean(x^2) + eps) * weight
    // Difference: rsqrt vs inversesqrt — same thing
