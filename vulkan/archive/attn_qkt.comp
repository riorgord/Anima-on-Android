#version 450
// Attention QK^T: attn[m_q, h, m_kv] = sum_d Q[m_q,h,d] * K[m_kv,h,d] * scale
// FP16 I/O, FP32 internal accumulation.
// Per (query_row, head) workgroup. 256 threads, each handles M_kv/256 kv indices.
#extension GL_EXT_shader_16bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer Qbuf { float16_t Q[]; };  // [M_q * H * D] flat
layout(binding = 1) readonly  buffer Kbuf { float16_t K[]; };  // [M_kv * H * D] flat
layout(binding = 2) writeonly buffer Abuf { float16_t A[]; };  // [M_q * H * M_kv] flat

layout(push_constant) uniform PC {
    uint M_q;    // per-head query tokens
    uint M_kv;   // per-head key tokens
    uint H;      // n_heads
    uint D;      // head_dim
    float scale; // 1/sqrt(D)
} pc;

void main() {
    // One WG per (query_row, head), flattened: gid = row * H + h
    uint gid = gl_WorkGroupID.x;
    uint total_q = pc.M_q * pc.H;
    if (gid >= total_q) return;

    uint m_q = gid / pc.H;
    uint h   = gid % pc.H;
    uint tid = gl_LocalInvocationID.x;

    uint q_off = m_q * pc.H * pc.D + h * pc.D;  // start of this query vector

    // Each thread handles M_kv values in strides of 256
    for (uint m_kv = tid; m_kv < pc.M_kv; m_kv += 256u) {
        float sum = 0.0;
        uint k_off = m_kv * pc.H * pc.D + h * pc.D;
        // Dot product: Q_row[h] · K_row[h]
        for (uint d = 0u; d < pc.D; d++) {
            sum += float(Q[q_off + d]) * float(K[k_off + d]);
        }
        sum *= pc.scale;
        // Store: A[gid * M_kv + m_kv]
        A[gid * pc.M_kv + m_kv] = float16_t(sum);
    }
}
