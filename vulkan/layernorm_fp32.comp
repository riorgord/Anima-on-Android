#version 450
// LayerNorm FP32 I/O — identical algorithm to _fp16 but float in/out.
// Avoids FP16 quantization error (max_err 0.037 → expected <0.002).
// One workgroup per row, 256 threads parallel reduction.
// I/O: float (IEEE 754 single precision), internal: float (same).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer In  { float in_data[];  };
layout(binding = 1) writeonly buffer Out { float out_data[]; };

layout(push_constant) uniform PC {
    uint n_rows;
    uint n_elems;
    float eps;
} pc;

shared float shm[256];

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.n_rows) return;

    uint tid = gl_LocalInvocationID.x;
    uint off = row * pc.n_elems;

    // Pass 1: compute mean
    float my_sum = 0.0;
    for (uint i = tid; i < pc.n_elems; i += 256u) {
        my_sum += in_data[off + i];
    }
    shm[tid] = my_sum;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) shm[tid] += shm[tid + s];
        barrier();
    }
    float mean = shm[0] / float(pc.n_elems);

    // Pass 2: compute variance
    float my_sq = 0.0;
    for (uint i = tid; i < pc.n_elems; i += 256u) {
        float d = in_data[off + i] - mean;
        my_sq += d * d;
    }
    shm[tid] = my_sq;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) shm[tid] += shm[tid + s];
        barrier();
    }
    float inv_std = inversesqrt(shm[0] / float(pc.n_elems) + pc.eps);

    // Pass 3: normalize
    for (uint i = tid; i < pc.n_elems; i += 256u) {
        out_data[off + i] = (in_data[off + i] - mean) * inv_std;
    }
}
