#version 450
// Element-wise fp16 add: out = in1 + in2  (used for residual connections)
#extension GL_EXT_shader_16bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer In1 { float16_t in1[]; };
layout(binding = 1) readonly  buffer In2 { float16_t in2[]; };
layout(binding = 2) writeonly buffer OutBuf { float16_t out_data[]; };

layout(push_constant) uniform PC { uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    out_data[i] = float16_t(float(in1[i]) + float(in2[i]));
}
