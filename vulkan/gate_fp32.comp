#version 450
// Gate residual: out = inBuf + gate * O_proj — all fp32.
// Matches PyTorch: x = x + gate * f(x) with fp32 precision.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer Oproj { float o_data[]; };
layout(binding = 1) readonly  buffer Gate  { float g_data[]; };
layout(binding = 2) readonly  buffer InBuf { float i_data[]; };
layout(binding = 3) writeonly buffer Out   { float out_data[]; };

layout(push_constant) uniform PC {
    uint n_total;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n_total) return;

    float o = o_data[i];   // O_proj output
    float g = g_data[i];   // gate
    float x = i_data[i];   // residual in
    out_data[i] = fma(g, o, x);  // x + gate * O_proj with single rounding
}
